[Unit]
Description=NATS Server for Speed Skating Timer
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/nats-server --config /home/pi/app/config/nats-creds/nats-server.conf
WorkingDirectory=/home/pi/app/config/nats-creds
Restart=always
RestartSec=5s
User=pi

[Install]
WantedBy=multi-user.target

